generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ============================================
// 用户
// ============================================
model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  emailVerified DateTime?
  passwordHash  String?

  // SafeW 登录
  safewId       String?  @unique
  safewUsername String?

  // Telegram 登录
  telegramId       String? @unique
  telegramUsername String?

  firstName     String?
  lastName      String?
  photoUrl      String?

  displayName   String?
  role          String   @default("USER")
  points        Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages      ChatMessage[]
  favorites     Favorite[]
  predictions   Prediction[]

  @@index([email])
}

// ============================================
// 邮箱验证码（注册/绑定用，暂留）
// ============================================
model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  code      String
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// ============================================
// 直播频道
// status: live | upcoming | replay | offline
// ============================================
model Channel {
  id          String   @id @default(cuid())
  name        String
  league      String   @default("综合")
  leagueIcon  String   @default("⚽")

  home        String?
  away        String?
  homeScore   Int?
  awayScore   Int?
  minute      Int?

  status      String   @default("live")
  coverUrl    String?
  streamUrl   String?
  viewers     Int      @default(0)

  startAt     DateTime?
  duration    Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  favorites   Favorite[]
  messages    ChatMessage[]

  @@index([status])
  @@index([league])
}

// ============================================
// 回放视频（YouTube 嵌入）
// ============================================
model ReplayVideo {
  id        String   @id @default(cuid())
  title     String
  league    String   @default("综合")
  leagueIcon String  @default("⚽")

  home      String?
  away      String?
  score     String?

  videoId   String              // YouTube 视频 ID
  duration  Int?                // 时长（秒）

  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([league])
  @@index([publishedAt])
}

// ============================================
// 收藏
// ============================================
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  channelId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([userId])
}

// ============================================
// 竞猜（虚拟积分，暂留）
// ============================================
model Prediction {
  id         String   @id @default(cuid())
  userId     String
  channelId  String
  pick       String
  points     Int      @default(10)
  isCorrect  Boolean?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([userId])
}

// ============================================
// 直播间聊天
// ============================================
model ChatMessage {
  id         String   @id @default(cuid())
  userId     String
  channelId  String
  content    String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@index([userId])
}