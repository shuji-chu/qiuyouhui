generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  emailVerified DateTime?

  safewId       String?  @unique
  safewUsername String?
  firstName     String?
  lastName      String?
  photoUrl      String?

  displayName   String?
  role          String   @default("USER")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  verifyCode       String?
  verifyCodeExpiry DateTime?

  @@index([email])
}