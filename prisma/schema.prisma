generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  emailVerified DateTime?

  safewId       String?  @unique
  safewUsername String?
  firstName     String?
  lastName      String?
  photoUrl      String?

  displayName   String?
  role          String   @default("USER")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([email])
}

// 独立的验证码表，登录和绑定共用
model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  code      String
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}