# ============================================
# 球友会 - 环境变量模板
# 复制到 .env.local 并填入真实值
# 不要直接把真实值提交到仓库！
# ============================================

# ---------- 会话密钥 ----------
# 生成命令：openssl rand -base64 32
JWT_SECRET=

# ---------- 站点地址 ----------
# 部署后改成你的正式域名，本地开发用 http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- SafeW 登录 ----------
# 从 SafeW @BotFather 拿到的 Bot Token
SAFEW_BOT_TOKEN=
# Bot 用户名（不带 @）
SAFEW_BOT_USERNAME=
# Bot 数字 ID（前端 Widget 用）
NEXT_PUBLIC_SAFEW_BOT_ID=

# ---------- Telegram 登录 ----------
# 从 Telegram @BotFather 拿到的 Bot Token
TELEGRAM_BOT_TOKEN=
# Bot 用户名（不带 @）
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# ---------- 邮箱（Yahoo SMTP）----------
# 发件邮箱
EMAIL_USER=
# Yahoo 应用密码（不是登录密码，16 位字母）
EMAIL_APP_PASS=