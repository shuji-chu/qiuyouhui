# ========== 数据库 ==========
# Postgres 连接串
DATABASE_URL=

# ========== SafeW 登录 ==========
# 从 @BotFather 拿到的 Bot Token
SAFEW_BOT_TOKEN=
# Bot 用户名（不带 @）
SAFEW_BOT_USERNAME=

# ========== 邮箱（Yahoo SMTP）==========
# 发件邮箱
EMAIL_USER=
# 应用密码（不是登录密码）
EMAIL_APP_PASS=

# ========== 站点地址 ==========
# 部署后填，本地开发用 http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
